<!-- 1. 美股 VIX 半圓情緒儀表板 -->
<div class="vix-gauge-box" style="max-width: 360px; text-align: center;">
  <h4>美股 VIX 情緒半圓（0~100）</h4>
  <svg id="usVixGaugeSvg" viewBox="0 0 240 135" style="width: 100%; height: auto;">
    <path d="M 20 115 A 100 100 0 0 1 220 115" fill="none" stroke="#e5e7eb" stroke-width="18" stroke-linecap="round" />
    <path id="usVixGaugeArc" d="M 20 115 A 100 100 0 0 1 220 115" fill="none" stroke="#f59e0b" stroke-width="18" stroke-linecap="round"
          stroke-dasharray="314.16" stroke-dashoffset="157.08" />
    <text id="usVixGaugeScore" x="120" y="92" text-anchor="middle" font-size="28" font-weight="bold" fill="#111827">--.-</text>
    <text id="usVixGaugeSub" x="120" y="116" text-anchor="middle" font-size="13" fill="#4b5563">載入中...</text>
  </svg>
</div>

<!-- 2. 可選：美股 VIX 波動率指數 (90日) 放在下方 -->
<div class="vix-90d-box" style="margin-top: 20px;">
  <h4>美股 VIX 波動率指數 (90日)</h4>
  <div style="height: 220px; position: relative;">
    <canvas id="usVix90dCanvas"></canvas>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  let usVix90dChartObj = null;

  function renderUsVixSemiGauge(usVix) {
    if (!usVix || usVix.score === null || usVix.score === undefined) return;
    const score = Math.max(0, Math.min(100, Number(usVix.score)));
    const totalArc = Math.PI * 100; // 半圓周長約 314.16
    const offset = totalArc * (1 - score / 100);

    const arcEl = document.getElementById("usVixGaugeArc");
    const scoreEl = document.getElementById("usVixGaugeScore");
    const subEl = document.getElementById("usVixGaugeSub");

    if (arcEl) {
      arcEl.style.strokeDasharray = totalArc.toFixed(2);
      arcEl.style.strokeDashoffset = offset.toFixed(2);
      arcEl.style.stroke = score < 25 ? "#dc2626" : score < 45 ? "#f59e0b" : score < 75 ? "#3b82f6" : "#10b981";
    }
    if (scoreEl) scoreEl.textContent = score.toFixed(1);
    if (subEl) subEl.textContent = `VIX ${usVix.price}（${usVix.status}・${usVix.date}）`;
  }

  function renderUsVix90dBelow(chartData) {
    const canvas = document.getElementById("usVix90dCanvas");
    if (!canvas || !chartData || !Array.isArray(chartData.dates)) return;
    if (usVix90dChartObj) usVix90dChartObj.destroy();

    usVix90dChartObj = new Chart(canvas, {
      type: "line",
      data: {
        labels: chartData.dates,
        datasets: [
          { label: "VIX 收盤", data: chartData.close, borderColor: "#2563eb", borderWidth: 2, pointRadius: 0 },
          { label: "20MA", data: chartData.ma20, borderColor: "#f59e0b", borderWidth: 1.5, pointRadius: 0, borderDash: [4, 2] },
          { label: "60MA", data: chartData.ma60, borderColor: "#10b981", borderWidth: 1.5, pointRadius: 0 }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: { mode: "index", intersect: false }
      }
    });
  }

  async function initVixWidgets() {
    const res = await fetch(`./data.json?t=${Date.now()}`);
    const data = await res.json();
    renderUsVixSemiGauge(data.usVix);
    renderUsVix90dBelow(data.usVixChart);
  }

  document.addEventListener("DOMContentLoaded", initVixWidgets);
</script>
